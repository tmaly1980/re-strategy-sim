# AI Strategy Advisor
# Copy this file to .env.local.
# Choose ONE provider, set its model, and add the matching API key.

AI_PROVIDER=openai
AI_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Example configurations:
#
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
#
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...
#
# AI_PROVIDER=xai
# AI_MODEL=grok-beta
# XAI_API_KEY=xai-...

# Never commit .env.local.
